# Server Configuration
PORT=5000

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=tailor_shop_db

# Automatic Synchronization Configuration
SYNC_ENABLED=true
SYNC_INTERVAL_SECONDS=25
# Providers: 'local' (built-in relay/dev), 'firebase' (Firebase Realtime DB), 'relay' (Custom Cloud Relay)
CLOUD_SYNC_PROVIDER=local
CLOUD_SYNC_URL=
SYNC_API_KEY=kapse-g-tailor-sync-sec-2026
FIREBASE_DB_URL=https://your-app-default-rtdb.firebaseio.com
FIREBASE_AUTH_KEY=

